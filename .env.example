# =============================================================================
# CHICKCHAU — PRODUCTION & VERCEL ENVIRONMENT CONFIGURATION (.env.example)
# =============================================================================
# IMPORTANT:
# - Never commit real secrets or service-role keys to Git.
# - Configure these variables in Vercel Project Settings -> Environment Variables.
# - Never expose SUPABASE_SECRET_KEY in any VITE_* variable.

# -----------------------------------------------------------------------------
# 1. SINGLE PRODUCTION ORIGIN (SEO, Canonicals, Sitemap, Open Graph, JSON-LD)
# -----------------------------------------------------------------------------
# Replace with your verified HTTPS production domain (no trailing slash).
# Leave empty or unconfigured in Preview until the real production domain is live.
SITE_URL="https://YOUR-REAL-PRODUCTION-DOMAIN"
VITE_SITE_URL="https://YOUR-REAL-PRODUCTION-DOMAIN"

# -----------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL CONFIGURATION (Vercel Serverless Functions)
# -----------------------------------------------------------------------------
# SUPABASE_URL: Project URL from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# SUPABASE_PUBLISHABLE_KEY: Public anon/publishable key (read-only catalog RLS)
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_ANON_KEY"

# SUPABASE_SECRET_KEY: Server-only secret / service_role key (NEVER prefix with VITE_)
SUPABASE_SECRET_KEY="YOUR_SUPABASE_SECRET_SERVICE_ROLE_KEY"

# -----------------------------------------------------------------------------
# 3. GOOGLE SEARCH CONSOLE OWNERSHIP VERIFICATION
# -----------------------------------------------------------------------------
# Paste the token from the Google Search Console HTML tag verification method.
GOOGLE_SITE_VERIFICATION="YOUR_REAL_VERIFICATION_TOKEN"
VITE_GOOGLE_SITE_VERIFICATION="YOUR_REAL_VERIFICATION_TOKEN"

# -----------------------------------------------------------------------------
# 4. GOOGLE ANALYTICS 4 (GA4)
# -----------------------------------------------------------------------------
# Paste your real Web Data Stream Measurement ID (format: G-XXXXXXXXXX).
GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
VITE_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"

# -----------------------------------------------------------------------------
# 5. GOOGLE MAPS PLATFORM (Checkout Interactive Map & Places Autocomplete)
# -----------------------------------------------------------------------------
# Browser API key restricted by HTTP referrer to your production domain.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_BROWSER_API_KEY"

# -----------------------------------------------------------------------------
# 6. ADMINISTRATOR ALLOWLIST (Server-Side Authorization)
# -----------------------------------------------------------------------------
# Comma-separated list of verified Google emails allowed to manage orders/prices.
ADMIN_EMAILS="itleo4444@gmail.com"
